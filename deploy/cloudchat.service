[Unit]
Description=CloudChat Flask App with Gunicorn
After=network.target redis-server.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=cloudchat
Group=cloudchat
WorkingDirectory=/opt/cloudchat
EnvironmentFile=/etc/cloudchat/cloudchat.env
Environment=HOME=/var/lib/cloudchat
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/cloudchat/venv/bin/gunicorn --worker-class gevent --workers 2 --worker-connections 50 --max-requests 1000 --max-requests-jitter 50 --worker-tmp-dir /run/cloudchat --timeout 300 --bind 127.0.0.1:5000 app:app

Restart=always
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=90

StateDirectory=cloudchat
StateDirectoryMode=0750
RuntimeDirectory=cloudchat
RuntimeDirectoryMode=0750
UMask=0077

CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
RemoveIPC=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
MemoryDenyWriteExecute=true
KeyringMode=private

OOMScoreAdjust=100
MemoryHigh=250M
MemoryMax=300M
TasksMax=128

[Install]
WantedBy=multi-user.target
